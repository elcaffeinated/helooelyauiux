# Copy to client/.env (local) or add as environment variables on your host (Vercel/Netlify).
# Your deployed site URL, no trailing slash. Needed for correct link previews.
VITE_SITE_URL=https://your-site.vercel.app
# Form service endpoint (e.g. Formspree). Leave empty to use the bundled Node API at /api/contact.
VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
